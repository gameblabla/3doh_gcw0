# SDL3 native backend.  Build with: make -f Makefile.sdl3
CC = gcc
TARGET = 3doh-sdl3
BUILD_DIR ?= build/sdl3
BPP_TYPE = 32
SDL3_CFLAGS ?= $(shell pkg-config --cflags sdl3 2>/dev/null || pkg-config --cflags SDL3 2>/dev/null)
SDL3_LIBS ?= $(shell pkg-config --libs sdl3 2>/dev/null || pkg-config --libs SDL3 2>/dev/null || echo -lSDL3)

CFLAGS ?= -O2 -std=gnu99 -Wall -Wextra
USE_HLE_SWI ?= 0
CFLAGS += -DDONTPACK -DTHREEDOH_PLATFORM_SDL3 -DBPP_TYPE=$(BPP_TYPE)
ifeq ($(USE_HLE_SWI),1)
CFLAGS += -DHLE_SWI
endif
CFLAGS += -Isrc -Isrc/freedo $(SDL3_CFLAGS)
LDFLAGS += $(SDL3_LIBS) -lm

CORE_SRCS = \
	src/freedo/arm.c src/freedo/DiagPort.c src/freedo/quarz.c src/freedo/Clio.c \
	src/freedo/frame.c src/freedo/Madam.c src/freedo/vdlp.c src/freedo/_3do_sys.c \
	src/freedo/bitop.c src/freedo/DSP.c src/freedo/Iso.c src/freedo/SPORT.c \
	src/freedo/XBUS.c src/freedo/freedo_fixedpoint_math.c \
	src/cdrom.c src/cuefile.c src/config.c src/input_script.c src/core/threedoh_core.c

SRCS = $(CORE_SRCS) src/platform/sdl3/threedoh_sdl3.c src/main_hosted.c
OBJS = $(patsubst %.c,$(BUILD_DIR)/%.o,$(SRCS))

all: $(TARGET)

$(BUILD_DIR)/%.o: %.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)

clean:
	rm -rf $(BUILD_DIR) $(TARGET)

.PHONY: all clean
